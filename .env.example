# Plantilla SIN valores reales: este archivo sí se sube a git.
# Copia este archivo como `.env.local` (git lo ignora) y llena ahí los valores.
# En el servidor de producción, define las mismas variables en el hosting.

# Dominio público del sitio (metadatos, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://karvo.lat

# Supabase → botón "Connect" del proyecto (o Project Settings → Data API).
# Es https://<project-ref>.supabase.co; el ref también aparece en la URL del
# dashboard: supabase.com/dashboard/project/<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys. Usa la llave SECRETA (sb_secret_…):
# solo la lee el servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Discord → Canal → Editar canal → Integraciones → Webhooks → Copiar URL.
# Es opcional: sin ella, los formularios se guardan pero no avisan.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
