# Plantilla SIN valores reales: este archivo sí se sube a git.
# Copia este archivo como `.env.local` (git lo ignora) y llena ahí los valores.
# En el servidor de producción, define las mismas variables en el hosting.

# Dominio público del sitio (metadatos, canonical, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://<dominio-de-arkha>

# Supabase → botón "Connect" del proyecto (o Project Settings → Data API).
# Es https://<project-ref>.supabase.co; el ref también aparece en la URL del
# dashboard: supabase.com/dashboard/project/<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys. Usa la llave SECRETA (sb_secret_…):
# solo la lee el servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Aviso por correo de cada solicitud (Resend → API Keys). El remitente debe
# ser de un dominio verificado en Resend; el destino puede llevar varios
# correos separados por comas. Opcional: sin estas variables, las solicitudes
# se guardan pero no avisan por correo.
RESEND_API_KEY=re_...
LEADS_EMAIL_FROM=Arkha <avisos@<dominio-verificado>>
LEADS_EMAIL_TO=<correo-designado-por-arkha>

# Discord → Canal → Editar canal → Integraciones → Webhooks → Copiar URL.
# Opcional: sin ella, las solicitudes se guardan pero no avisan en Discord.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
